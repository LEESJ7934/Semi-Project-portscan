# MySQL Docker 설정
MYSQL_ROOT_PASSWORD=replace_locally
MYSQL_DATABASE=port_scan
MYSQL_USER=portuser
MYSQL_PASSWORD=replace_locally

# 포트스캐너 DB 연결 설정
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=portuser
DB_PASSWORD=replace_locally
DB_NAME=port_scan

# 허가된 로컬 DVWA 실습환경
DVWA_BASE_URL=http://127.0.0.1:8080
DVWA_USERNAME=admin
DVWA_PASSWORD=replace_locally
DVWA_HOST=127.0.0.1

# Nuclei 설정
# Nuclei가 PATH에 등록됐다면 NUCLEI_PATH는 비워도 됩니다.
NUCLEI_PATH=
NUCLEI_TEMPLATES_PATH=

# 테스트 대상
# 반드시 본인 소유 또는 명시적으로 허가받은 시스템만 입력합니다.
LAB_TARGET=127.0.0.1